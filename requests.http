@host = http://localhost:8080/api
@admin = COLE_AQUI_O_TOKEN_DO_ADMIN
@cliente = COLE_AQUI_O_TOKEN_DO_CLIENTE

###
POST {{host}}/users/login
Content-Type: application/json

{ "email": "admin@authserver.com", "password": "admin" }

###
POST {{host}}/users/login
Content-Type: application/json

